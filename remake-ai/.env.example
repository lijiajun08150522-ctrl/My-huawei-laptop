# ================================
# Remake AI 环境变量配置
# ================================
# 复制此文件为 .env 并填写实际值

# ================================
# Flask 配置
# ================================
FLASK_ENV=production
FLASK_PORT=5000

# Flask 密钥（请更改为强随机字符串）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# JWT 密钥（请更改为强随机字符串）
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_EXPIRATION=86400  # 24小时（秒）

# ================================
# ComfyUI 配置
# ================================
# ComfyUI 服务地址
# 如果 ComfyUI 运行在宿主机，使用: host.docker.internal:8188
# 如果 ComfyUI 在 Docker 容器中，使用服务名: comfyui:8188
COMFYUI_URL=http://host.docker.internal:8188

# ComfyUI API 配置
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
COMFYUI_STEPS=30
COMFYUI_CFG=7.5

# ================================
# 数据库配置
# ================================
# 数据库类型: sqlite 或 postgresql
DB_TYPE=postgresql

# SQLite 配置（开发环境）
DATABASE_PATH=data/remake_ai.db

# PostgreSQL 配置（生产环境）
POSTGRES_USER=remake_user
POSTGRES_PASSWORD=your-strong-postgres-password-change-this
POSTGRES_DB=remake_ai
DATABASE_URL=postgresql://remake_user:your-strong-postgres-password-change-this@db:5432/remake_ai

# ================================
# 日志配置
# ================================
LOG_LEVEL=INFO
LOG_FILE=logs/remake_ai.log

# ================================
# CORS 配置
# ================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ================================
# 速率限制
# ================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10

# ================================
# 文件上传配置
# ================================
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=data/uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif

# ================================
# ComfyUI API Key（如果需要）
# ================================
COMFYUI_API_KEY=
